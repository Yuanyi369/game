{
  "name": "insta360-ace-pro-2-structure-lab",
  "version": "1.0.0",
  "description": "Interactive Three.js exploded view of the Insta360 Ace Pro 2 - all geometry generated in code.",
  "scripts": {
    "build": "esbuild src/app.js --bundle --format=iife --target=es2020 --outfile=bundle.js --loader:.js=js --minify",
    "build:dev": "esbuild src/app.js --bundle --format=iife --target=es2020 --outfile=bundle.js --loader:.js=js",
    "preview": "python -m http.server 8765"
  },
  "keywords": [
    "three.js",
    "3d",
    "interactive",
    "teardown",
    "insta360",
    "action-camera"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  },
  "private": true
}
